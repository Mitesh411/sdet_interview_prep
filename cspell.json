{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "files": ["**/*.md"],
  "ignorePaths": ["node_modules/**", ".git/**", ".cspell/**"],
  "dictionaryDefinitions": [
    {
      "name": "tech-words",
      "path": "./.cspell/tech-words.txt",
      "addWords": true,
      "description": "Testing, AWS/ML and tooling terms used in this repo. Add new terms here (one per line, sorted)."
    }
  ],
  "dictionaries": ["tech-words", "softwareTerms", "aws", "companies", "fullstack", "java", "typescript", "sql", "en_GB"],
  "ignoreWords": ["Mitesh", "Dandade", "Capegemini"],
  "ignoreRegExpList": [
    "/[A-Za-z]*\\*\\*[A-Za-z]{1,2}\\*\\*[A-Za-z]+/g",
    "/[\\u{1D400}-\\u{1D7FF}]+/gu"
  ]
}
